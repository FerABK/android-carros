<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_aplicativo"
            android:textColor="#202A44"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="40dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitulo_aplicativo"
            android:textColor="#777777"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="40dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_menu"
            android:textColor="#202A44"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/menuMarcas"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:text="@string/menu_marcas"
            android:textColor="#202A44"
            android:textSize="18sp"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/menuModelos"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:text="@string/menu_modelos"
            android:textColor="#202A44"
            android:textSize="18sp"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/menuCidades"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:text="@string/menu_cidades"
            android:textColor="#202A44"
            android:textSize="18sp"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/menuAnuncios"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:text="@string/menu_anuncios"
            android:textColor="#202A44"
            android:textSize="18sp"
            android:elevation="2dp" />

    </LinearLayout>
</ScrollView>